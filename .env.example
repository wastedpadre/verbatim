# ---- paths -----------------------------------------------------------------
# Comma-separated. These are paths INSIDE the container.
MEDIA_ROOTS=/media
DATA_DIR=/config

# ---- model -----------------------------------------------------------------
# large-v3   best quality, ~4.7 GB VRAM at float16 (fits 8 GB, little spare)
# medium.en  noticeably faster, fine for clean dubs
# distil-large-v3  ~2x faster than large-v3, small accuracy cost
MODEL_SIZE=large-v3
DEVICE=cuda
# float16        best accuracy, ~4.7 GB for large-v3
# int8_float16   ~2.6 GB, small accuracy cost. Use this if the card is shared
#                with Plex/Jellyfin GPU transcoding, or you hit OOM.
COMPUTE_TYPE=float16
BEAM_SIZE=5

# One job per GPU. Leave at 1 on a single card -- two jobs on one GPU just
# contend for the same VRAM and both run slower. On an 8 GB card like a
# 2070 Super this will also OOM.
CONCURRENCY=1

# ---- voice activity detection ----------------------------------------------
# VAD gates audio BEFORE the model sees it, so whatever it drops is gone for
# good. On dub audio with loud scoring this is the main cause of missing
# dialogue. Change these and restart -- no rebuild needed.
#
# The single most informative experiment is VAD_FILTER=false: it hands all
# audio to the model and lets the hallucination filters clean up afterwards.
VAD_FILTER=true
VAD_THRESHOLD=0.30
VAD_MIN_SPEECH_MS=100
VAD_MIN_SILENCE_MS=400
VAD_SPEECH_PAD_MS=400

# ---- caption shaping -------------------------------------------------------
MAX_CHARS_PER_LINE=42
MAX_LINES=2
MAX_CPS=20
MIN_CUE_DUR=0.8
MAX_CUE_DUR=7.0

# ---- output ----------------------------------------------------------------
# Jellyfin and Plex both pick this up automatically as an English track.
OUTPUT_SUFFIX=.en.dubtitles.srt
OVERWRITE=false

# ---- LLM polish (optional) -------------------------------------------------
# Repairs words the decoder misheard but which are clearly wrong in context
# ("revert to" where "refer to" was said). Roughly 2 cents per episode.
# Off by default: it costs money and sends cue text to Google.
POLISH_ENABLED=false
GEMINI_API_KEY=
# "gemini-flash-latest" tracks the current Flash model, so a Google
# deprecation doesn't 404 your pipeline. Explicit alternatives if you want to
# pin: gemini-3.6-flash (cheapest Flash), gemini-3.5-flash-lite (cheaper still,
# likely fine for this task). List what your key can call with:
#   docker exec verbatim python3 -c "import requests;from app import config; \
#     print([m['name'] for m in requests.get( \
#     'https://generativelanguage.googleapis.com/v1beta/models', \
#     params={'key':config.GEMINI_API_KEY}).json()['models']])"
POLISH_MODEL=gemini-flash-latest

# Guardrails. Raise similarity or lower the word delta to be stricter about
# what counts as a correction rather than a rewrite.
# Larger windows = fewer API calls and more context per judgement.
POLISH_WINDOW=40
POLISH_OVERLAP=6

# Windows are independent and sent concurrently. This is the main lever on
# how long the polish stage takes. Lower it if you hit Gemini rate limits.
POLISH_CONCURRENCY=6

# "minimal" for Gemini 3.x (it cannot be fully disabled on Flash), or set
# blank to leave the model's default. This task is constrained substitution,
# so reasoning is latency you don't need.
POLISH_THINKING=minimal
POLISH_MIN_SIMILARITY=0.70
POLISH_MAX_WORD_DELTA=1

LOG_LEVEL=INFO
